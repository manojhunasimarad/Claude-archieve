<?xml version="1.0" encoding="utf-8"?>
<!-- The app serves its own bundled files from a server inside the app on 127.0.0.1.
     Plain http is allowed only for that address; everything else stays https-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
